<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="[1.19.0]" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="[1.19.0]" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="[1.19.0]" />
  </ItemGroup>
</Project>
