{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>apitally/renovate-config"],
  "packageRules": [
    {
      "description": "Keep minimum versions required by the library",
      "matchFileNames": ["src/Apitally/Apitally.csproj"],
      "enabled": false
    },
    {
      "description": "Keep tests on the library's minimum OpenTelemetry version",
      "matchFileNames": ["tests/Apitally.Tests/Apitally.Tests.csproj"],
      "matchPackageNames": ["OpenTelemetry.*"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
